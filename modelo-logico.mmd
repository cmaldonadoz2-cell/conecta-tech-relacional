        text enlace
        varchar codigo_acceso
    }

    ACREDITACION {
        integer id_acreditacion PK
        varchar nombre UK
        text descripcion
    }

    INSCRIPCION_EDICION {
        integer id_inscripcion_edicion PK
        integer id_persona FK
        integer id_edicion FK
        boolean es_asistente
        boolean es_ponente
        integer id_acreditacion FK
    }

    PERFIL_PONENTE {
        integer id_persona PK,FK
        text biografia
    }

    INSCRIPCION_SESION {
        integer id_inscripcion_sesion PK
        integer id_inscripcion_edicion FK
